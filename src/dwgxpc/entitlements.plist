<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The DWG conversion service handles untrusted files, so it is sandboxed
	     with no file access of its own. It reads and writes only the handles
	     the Quick Look extension passes it, plus its own temporary folder. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
