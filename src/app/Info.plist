<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>MacCADPreview</string>
	<key>CFBundleIdentifier</key>
	<string>com.maccadpreview</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Mac CAD Preview</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Both version keys are overwritten by build.sh from the VERSION file at
	     the repository root. The values here are only a fallback. -->
	<key>CFBundleShortVersionString</key>
	<string>0.2.0</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>

	<!-- Deliberately no CFBundleDocumentTypes. Declaring one would make this app
	     the default opener for those files, and it cannot open anything: it
	     exists only so macOS can find the Quick Look extension. Previews need
	     the types below to exist, not a handler for them. -->

	<!-- macOS ships no UTI for STEP or IGES, so we declare them. STL, OBJ and
	     PLY already have system UTIs and must NOT be redeclared here. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.maccadpreview.step</string>
			<key>UTTypeDescription</key>
			<string>STEP CAD Model</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.3d-content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>step</string>
					<string>stp</string>
					<string>stpz</string>
					<string>p21</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.maccadpreview.iges</string>
			<key>UTTypeDescription</key>
			<string>IGES CAD Model</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.3d-content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>iges</string>
					<string>igs</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.maccadpreview.3mf</string>
			<key>UTTypeDescription</key>
			<string>3D Manufacturing Format</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.3d-content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>3mf</string>
				</array>
			</dict>
		</dict>
	</array>

	<!-- Other CAD apps export their own UTIs for these extensions, and whichever
	     app Launch Services picks as the owner decides what a file "is". Quick
	     Look routes on that, so a file owned by another app's UTI is never
	     offered to our extension at all — the spacebar just does nothing.
	     Importing their types lets us handle those files too. Importing does not
	     claim to open anything; it only says the type is known here. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.belighten.modelshow.3dfiles</string>
			<key>UTTypeDescription</key>
			<string>3D Manufacturing Format</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.3d-content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>3mf</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.shapr3d.step</string>
			<key>UTTypeDescription</key>
			<string>STEP CAD Model</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.3d-content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>step</string>
					<string>stp</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.shapr3d.3d-manufacturing.3mf</string>
			<key>UTTypeDescription</key>
			<string>3D Manufacturing Format</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.3d-content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>3mf</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
